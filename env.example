# Public site URL (no trailing slash). Used to build Pesapal callback/IPN URLs.
# Local dev:  http://localhost:3000
# Production: https://shaurimoyosda.vercel.app  (or your real domain)
NEXT_PUBLIC_APP_URL=

# --- Pesapal -----------------------------------------------------------
# From your Pesapal merchant dashboard > Settings > API Keys
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=

# "sandbox" while testing, "live" once you're ready to take real payments
PESAPAL_ENV=sandbox

# Filled in AFTER you run scripts/register-ipn.ts once (see PESAPAL_SETUP.md)
PESAPAL_IPN_ID=

# --- Supabase ------------------------------------------------------------
# From your Supabase project > Settings > API
SUPABASE_URL=
# The SERVICE ROLE key (secret, server-only) — NOT the anon/public key.
# Never prefix this with NEXT_PUBLIC_ or it will be exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
